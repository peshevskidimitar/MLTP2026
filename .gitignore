# The local environment and the leavings of editors and interpreters.
.venv/
__pycache__/
.ipynb_checkpoints/
.DS_Store

# Material that has not been released to the students yet. Delete a day's line
# when that day's session arrives.
/Day 5 - Generative AI and AI Agents/
/Day 6 - Learning With Time-Varying Data/
